Bootstrap: docker
From: nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

%labels
    Author kstarxin
    Version 1.0
    Description CUDA 11.8 Program-as-Weights Training Container

%post
    # Set non-interactive frontend for apt
    export DEBIAN_FRONTEND=noninteractive

    # Install system dependencies
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common \
        gpg-agent \
        ca-certificates \
        python3 \
        python3-dev \
        python3-venv \
        python3-pip \
        git \
        wget \
        curl \
        vim \
        build-essential \
        cmake \
        ninja-build \
        pkg-config \
        libaio-dev \
        libopenmpi-dev \
        openmpi-bin \
        libssl-dev \
        ffmpeg \
        poppler-utils

    # Create symlinks for python
    ln -sf /usr/bin/python3 /usr/bin/python

    # Install uv (fast Python package installer)
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH="/root/.local/bin:$PATH"

    # Install build tools
    uv pip install --system --break-system-packages setuptools wheel packaging meson-python meson ninja cython pybind11

    # Install PyTorch with CUDA 11.8 support
    uv pip install --system --break-system-packages \
        --index-url https://download.pytorch.org/whl/cu118 \
        torch==2.7.1+cu118 \
        torchaudio==2.7.1+cu118 \
        torchvision==0.22.1+cu118

    # Install Python dependencies
    uv pip install --system --break-system-packages \
        transformers==4.51.0 \
        datasets==3.6.0 \
        accelerate==1.13.0 \
        peft==0.10.0 \
        trl==0.7.10 \
        gradio==3.50.2 \
        gradio_client==0.6.1 \
        scipy \
        sentencepiece \
        sentence-transformers==5.2.3 \
        protobuf \
        tiktoken \
        einops \
        rouge-chinese \
        nltk \
        textblob \
        uvicorn \
        pydantic \
        fastapi \
        deepspeed==0.18.6 \
        transformers_stream_generator

    # ============================================
    # Cleanup to reduce image size
    # ============================================

    # Clean apt cache using built-in commands
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/*

    # Clean uv cache using built-in command
    uv cache clean

    # Remove Python bytecode cache
    find /usr -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true
    find /opt -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

%environment
    # CUDA settings for better compatibility
    export CUDA_DEVICE_ORDER=PCI_BUS_ID

    # Ensure uv is in PATH
    export PATH="/root/.local/bin:$PATH"

%runscript
    exec python "$@"